---
import { render } from "astro:content"
import Art from "./Art.astro"

const { card } = Astro.props
const { title, tagline, tag, year, art, background, ink, links } = card.data
const { Content } = await render(card)
---

<li class="slot">
  <div class="mover" style={`--c:${background};--t:${ink}`}>
    <div class="card">
      <button class="face front" type="button" aria-label={`${title}. ${tagline} Flip card`}>
        <span class="meta"><span>{tag}</span><span>{year}</span></span>
        <Art name={art} background={background} />
        <h2>{title}</h2>
        <span class="org">{tagline}</span>
      </button>
      <div class="face back" tabindex="-1" inert>
        <span class="meta"><span>{tag}</span><span>{year}</span></span>
        <h3>{title}</h3>
        <div class="copy"><Content /></div>
        {links.length > 0 && (
          <div class="actions">
            {links.map(link => <a class="go" href={link.url}>{link.label}</a>)}
          </div>
        )}
      </div>
    </div>
    <button class="close" type="button" aria-label={`Close ${title}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
</li>
